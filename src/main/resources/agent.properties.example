# ==========================================================
# 智能图书问答（RAG Agent）配置文件模板
#
# 本模块使用 OpenAI 兼容协议调用大模型，支持任意提供
# POST {base.url}/chat/completions 接口的服务：
#   · 千问AI平台      https://maas.qianwenai.com/compatible-mode/v1
#   · DeepSeek        https://api.deepseek.com
#   · 本地 Ollama     http://localhost:11434/v1
#   · vLLM / One-API  自建网关的 OpenAI 兼容地址
#
# 使用方式：
#   1. 复制本文件为同目录下的 agent.properties（去掉 .example 后缀）
#   2. 按下面「方案 A」或「方案 B」填写其中一组
#   3. agent.properties 已被 .gitignore 忽略，不会提交到仓库
#
# 读取优先级：环境变量 DEEPSEEK_API_KEY > 系统属性 -Ddeepseek.api.key > 本文件
# ==========================================================


# ==========================================================
# 方案 A：使用千问AI平台（当前推荐）
# ==========================================================
# 1. 登录 https://platform.qianwenai.com
# 2. 左侧「API Keys」→ 点右上角「创建 API Key」→ 复制（只显示一次）
# 3. 同一页面上方「按量付费 Base URL → OpenAI 兼容」处点复制按钮，
#    得到形如 https://maas.qianwenai.com/compatible-mode/v1 的地址
# 4. 模型名到「模型广场」查看，本项目建议用 qwen-plus
#
# 注意：千问的 Key 形如 sk-ws-H.xxxx.yyyy.zzzz...，较长且含点号，属正常现象
agent.api.key=在千问平台创建API Key后粘贴到这里
agent.base.url=https://maas.qianwenai.com/compatible-mode/v1
agent.model=qwen-plus


# ==========================================================
# 方案 B：使用 DeepSeek 官方（如需切换，注释掉方案 A 再启用本段）
# ==========================================================
# 申请地址：https://platform.deepseek.com → API keys → 创建
# Key 形如 sk-xxxx（约 35 字符）
#
# agent.api.key=sk-你的DeepSeekKey
# agent.base.url=https://api.deepseek.com
# agent.model=deepseek-chat


# ==========================================================
# 通用参数（两个方案共用）
# ==========================================================

# 单次请求超时（秒）。大模型首次响应可能较慢，建议 60~120
agent.timeout.seconds=60

# 每次从数据库检索多少本相关图书作为知识库上下文
# 数值越大信息越全，但消耗 token 越多、响应越慢
agent.top.k=8