# ==========================================================
# 数据库连接配置模板
#
# 使用方式：
#   1. 复制本文件为同目录下的 db.properties（同名去掉 .example）
#   2. 修改下面对应的值
#   3. db.properties 已被 .gitignore 忽略，不会被提交到仓库
#
# 读取优先级：系统属性(-Ddb.password=xxx) > 环境变量(DB_PASSWORD) > 本文件 > 代码内置默认值
# 也就是说：如果你只想临时改密码，不用建文件，直接在 IDEA 运行配置的
#          VM options 里写 -Ddb.password=你的密码 即可。
# ==========================================================

# JDBC 驱动类，MySQL 8 固定为 com.mysql.cj.jdbc.Driver
db.driver=com.mysql.cj.jdbc.Driver

# 数据库地址；数据库名必须是 book_manage
db.url=jdbc:mysql://localhost:3306/book_manage?useSSL=false&serverTimezone=Asia/Shanghai&useUnicode=true&characterEncoding=UTF-8&allowPublicKeyRetrieval=true

# 数据库账号
db.username=root

# 数据库密码（改成你自己本机 MySQL 的密码）
db.password=123456